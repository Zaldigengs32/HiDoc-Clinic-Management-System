<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Apoteker.Controller.DataPengadaanObatController">

    <!-- Main Background -->
    <AnchorPane style="-fx-background-color: linear-gradient(to bottom, #c1e3fe, #cfeff9);">

        <!-- Main Container -->
        <VBox spacing="25" style="-fx-background-color: rgba(255,255,255,0.6); -fx-background-radius: 25; -fx-padding: 25; -fx-border-radius: 25; -fx-border-color: rgba(255,255,255,0.3);" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">

            <effect>
                <DropShadow color="#c0e0ec" offsetX="0" offsetY="10" radius="20" />
            </effect>

            <!-- Header + Search + Filter + Button -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="📦 Transaksi Pengadaan Obat" />
                <Region HBox.hgrow="ALWAYS" />

                <DatePicker fx:id="dpTanggalFilter" prefHeight="35.0" prefWidth="200.0" promptText="Cari Data by Tanggal">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor></DatePicker>

                <!-- Tombol Refresh -->
                <Button fx:id="btnRefresh" onAction="#refreshData" prefHeight="35.0" prefWidth="39.0" style="-fx-background-color: linear-gradient(to right, #3498db, #2980b9); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 12; -fx-cursor: hand;" text="🔄">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor></Button>

                <!-- Search Field -->
                <TextField fx:id="searchField" prefHeight="35.0" prefWidth="200.0" promptText="🔍 Cari Data Transaksi" style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-font-size: 13px; -fx-padding: 5 10; -fx-border-color: #d0d0d0; -fx-border-width: 1; -fx-background-color: white;" />

                <!-- Tombol Tambah -->
                <Button fx:id="btnTambah" maxWidth="220" onAction="#tampilkanFormPengadaan" prefHeight="35.0" prefWidth="170.0" style="-fx-background-color: linear-gradient(to right, #27ae60, #2ecc71); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 12; -fx-cursor: hand;" text="➕ Tambah Transaksi">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor></Button>
            </HBox>

            <!-- TableView -->
            <TableView fx:id="tabelPengadaan" style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12; -fx-border-color: #d0d0d0;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colIDPengadaan" prefWidth="125.0" text="🆔 ID Pengadaan" />
                    <TableColumn fx:id="colNamaKaryawan" prefWidth="260.0" text="👤 Karyawan" />
                    <TableColumn fx:id="colNamaSupplier" prefWidth="260.0" text="🏢 Supplier" />
                    <TableColumn fx:id="colTanggalPembelian" prefWidth="180.0" text="📅 Tanggal Pembelian" />
                    <TableColumn fx:id="colTotalHarga" prefWidth="200.0" text="💰 Total Harga" />
                    <TableColumn fx:id="colAksi" prefWidth="90.0" text="⚙ Aksi" />
                </columns>
                <cursor>
                    <Cursor fx:constant="HAND" />
                </cursor>
            </TableView>
        </VBox>
    </AnchorPane>

    <!-- Modal Form Overlay -->
    <VBox fx:id="formPopup" alignment="CENTER" managed="false" style="-fx-background-color: rgba(0,0,0,0.6);" visible="false" StackPane.alignment="CENTER">

        <!-- Form Container -->
        <VBox alignment="CENTER" maxWidth="800.0" prefHeight="719.0" prefWidth="800.0" spacing="20" style="-fx-background-color: linear-gradient(to bottom, #ffffff, #f8f9fa); -fx-padding: 35; -fx-border-radius: 25; -fx-background-radius: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 20, 0.6, 0, 8);">

            <!-- Form Header with Close Button -->
            <HBox alignment="CENTER" spacing="0" style="-fx-padding: 0 0 15 0;">
                <Region HBox.hgrow="ALWAYS" />
                <!-- Form Title -->
                <Label fx:id="formTitle" minHeight="50.0" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: linear-gradient(to right, #2c3e50, #34495e);" text="📋 Form Pengadaan Obat">
               <HBox.margin>
                  <Insets left="50.0" />
               </HBox.margin></Label>
                <Region HBox.hgrow="ALWAYS" />
                <!-- Close Button -->
                <Button fx:id="btnCloseForm" onAction="#tutupForm" prefHeight="40.0" prefWidth="44.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18px; -fx-background-radius: 15; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(231,76,60,0.4), 5, 0.3, 0, 2);" text="✕">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin>
                </Button>
            </HBox>

            <!-- Form Fields Container -->
            <VBox prefHeight="434.0" prefWidth="730.0" spacing="20" style="-fx-padding: 15;">

                <!-- First Row: ID Pengadaan dan Karyawan -->
                <HBox spacing="20">
                    <VBox prefWidth="350" spacing="8">
                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="🆔 ID Pengadaan" />
                        <TextField fx:id="tfIDPengadaan" editable="false" minHeight="45.0" prefHeight="30.0" style="-fx-background-color: linear-gradient(to bottom, #caeaf7, #caeaf7); -fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12; -fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Auto Generate">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font></TextField>
                    </VBox>

                    <VBox prefWidth="350" spacing="8">
                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="👤 Karyawan" />
                        <TextField fx:id="tfNamaKaryawan" editable="false" minHeight="45.0" style="-fx-background-color: linear-gradient(to bottom, #caeaf7, #caeaf7); -fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12; -fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Auto dari Login">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font></TextField>
                    </VBox>
                </HBox>

                <!-- Second Row: Supplier dan Tanggal -->
                <HBox spacing="20">
                    <VBox prefWidth="350" spacing="8">
                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="🏢 Pilih Supplier" />
                        <ComboBox fx:id="cbSupplier" minHeight="45.0" prefWidth="350" promptText="Pilih supplier obat" style="-fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 8; -fx-font-size: 14px; -fx-background-color: white;">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <!-- Akan diisi dari database -->
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </VBox>

                    <VBox prefWidth="350" spacing="8">
                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="📅 Tanggal Pembelian" />
                        <TextField fx:id="tfTanggalPembelian" editable="false" minHeight="45.0" style="-fx-background-color: linear-gradient(to bottom, #caeaf7, #caeaf7); -fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12; -fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Auto (Tanggal Sekarang)">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font></TextField>
                    </VBox>
                </HBox>

                <!-- Third Row: Pilih Obat dan Kuantitas -->
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <VBox prefHeight="80.0" prefWidth="218.0" spacing="8">
                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="💊 Pilih Obat" />
                        <ComboBox fx:id="cbObat" minHeight="45.0" minWidth="150.0" prefHeight="30.0" prefWidth="203.0" promptText="Pilih obat" style="-fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 8; -fx-font-size: 14px; -fx-background-color: white;">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <!-- Akan diisi dari database -->
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </VBox>

                    <VBox prefHeight="75.0" prefWidth="178.0" spacing="8">
                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="🔢 Kuantitas" />
                        <TextField fx:id="tfKuantitas" editable="true" maxHeight="45.0" maxWidth="235.0" minHeight="45.0" minWidth="115.0" prefColumnCount="0" prefHeight="50.0" prefWidth="183.0" style="-fx-background-color: linear-gradient(to bottom, #ffffff, #ffffff); -fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12; -fx-font-size: 14px; -fx-text-fill: #7f8c8d;" />
                    </VBox>

                    <VBox prefHeight="80.0" prefWidth="204.0" spacing="8">
                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="💰 Harga Satuan" />
                        <TextField fx:id="tfHargaSatuan" editable="true" maxHeight="45.0" maxWidth="235.0" minHeight="45.0" minWidth="115.0" prefColumnCount="0" prefHeight="50.0" prefWidth="183.0" style="-fx-background-color: linear-gradient(to bottom, #ffffff, #ffffff); -fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12; -fx-font-size: 14px; -fx-text-fill: #7f8c8d;">
                            <VBox.margin>
                                <Insets />
                            </VBox.margin>
                        </TextField>
                    </VBox>

                    <VBox alignment="BOTTOM_LEFT" spacing="20" />
                    <Pane prefHeight="80.0" prefWidth="167.0">
                        <children>
                            <Button fx:id="btnTambahKeranjang" layoutX="-27.0" layoutY="28.0" maxHeight="45.0" minHeight="45.0" onAction="#tambahKeKeranjang" prefHeight="50.0" prefWidth="159.0" style="-fx-background-color: linear-gradient(to right, #3498db, #2980b9); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 12; -fx-cursor: hand;" text="➕ Tambah" />
                        </children>
                    </Pane>
                </HBox>

                <!-- Keranjang Table -->
                <VBox spacing="10">
                    <TableView fx:id="tabelKeranjang" prefHeight="200.0" prefWidth="699.0" style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12; -fx-border-color: #d0d0d0;">
                        <columns>
                            <TableColumn fx:id="colNamaObat" prefWidth="245.0" text="Nama Obat" />
                            <TableColumn fx:id="colKuantitas" prefWidth="100" text="Kuantitas" />
                            <TableColumn fx:id="colHargaSatuan" prefWidth="150" text="Harga Satuan" />
                            <TableColumn fx:id="colSubTotal" prefWidth="150" text="Subtotal" />
                            <TableColumn fx:id="colHapus" prefWidth="50.0" text="Hapus" />
                        </columns>
                    </TableView>
                </VBox>
            </VBox>

            <HBox alignment="CENTER" maxWidth="699.0" minHeight="55.0" minWidth="699.0" prefHeight="98.0" prefWidth="699.0" spacing="20" style="-fx-padding: 10 0 5 0;">
                <VBox prefWidth="350" spacing="5">
                    <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="💳 Masukkan Jumlah Uang" />
                    <TextField fx:id="tfJumlahUang" editable="true" prefHeight="44.0" prefWidth="318.0" promptText="Masukkan jumlah uang" style="-fx-background-color: white; -fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 10; -fx-font-size: 14px; -fx-text-fill: #2c3e50;" />
                </VBox>

                <VBox prefWidth="350" spacing="5">
                    <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="💸 Total Kembalian" />
                    <TextField fx:id="tfKembalian" editable="false" prefHeight="44.0" prefWidth="334.0" promptText="Kembalian" style="-fx-background-color: linear-gradient(to bottom, #e8f5e8, #c8e6c8); -fx-border-color: #4caf50; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 10; -fx-font-size: 14px; -fx-text-fill: #4caf50;" text="Kembalian" />
                </VBox>
            </HBox>

            <!-- Action Buttons -->
            <HBox alignment="CENTER" maxHeight="30.0" prefHeight="30.0" prefWidth="730.0" spacing="25.0" style="-fx-padding: 20 0 0 0;">

                <!-- Total -->
                <HBox alignment="CENTER_RIGHT" prefHeight="44.0" prefWidth="330.0" spacing="10">
                    <Label prefHeight="27.0" prefWidth="174.0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="💰 Total Belanja:" />
                    <Label fx:id="lblTotalBelanja" prefHeight="30.0" prefWidth="173.0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" text="Rp 0" />
                </HBox>
                <Button fx:id="btnSimpan" minHeight="44.0" onAction="#simpanPengadaan" prefHeight="44.0" prefWidth="159.0" style="-fx-background-color: linear-gradient(to right, #27ae60, #2ecc71); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 15; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(39,174,96,0.4), 8, 0.3, 0, 3);" text="💾 Simpan">
                    <HBox.margin>
                        <Insets />
                    </HBox.margin></Button>
                <Button fx:id="btnBatal" minHeight="43.0" onAction="#batalPengadaan" prefHeight="44.0" prefWidth="159.0" style="-fx-background-color: linear-gradient(to right, #f39c12, #e67e22); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 15; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(243,156,18,0.4), 8, 0.3, 0, 3);" text="🔄 Batal Transaksi" />
            </HBox>
        </VBox>
    </VBox>

    <!-- Modal Detail Overlay -->
    <VBox fx:id="detailPopup" alignment="CENTER" managed="false" style="-fx-background-color: rgba(0,0,0,0.6);" visible="false" StackPane.alignment="CENTER">

        <!-- Detail Container -->
        <VBox alignment="CENTER" maxWidth="700" spacing="20" style="-fx-background-color: linear-gradient(to bottom, #ffffff, #f8f9fa); -fx-padding: 35; -fx-border-radius: 25; -fx-background-radius: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 20, 0.6, 0, 8);">

            <!-- Detail Title -->
            <Label fx:id="detailTitle" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: linear-gradient(to right, #2c3e50, #34495e); -fx-padding: 0 0 15 0;" text="📋 Detail Pengadaan Obat" />

            <!-- Detail Info -->
            <HBox alignment="CENTER" spacing="30">
                <AnchorPane prefWidth="343.0">
                    <children>
                        <VBox alignment="CENTER_LEFT" prefHeight="62.0" prefWidth="298.0" spacing="10.0">
                            <Label fx:id="lblDetailID" prefHeight="26.0" prefWidth="306.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="ID Pengadaan         :">
                                <VBox.margin>
                                    <Insets left="40.0" />
                                </VBox.margin>
                            </Label>
                            <Label fx:id="lblDetailKaryawan" prefHeight="26.0" prefWidth="326.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Karyawan       :">
                                <VBox.margin>
                                    <Insets left="40.0" />
                                </VBox.margin>
                            </Label>
                        </VBox>
                    </children>
                </AnchorPane>
                <VBox alignment="CENTER_LEFT" prefHeight="62.0" prefWidth="251.0" spacing="10">
                    <Label fx:id="lblDetailSupplier" prefHeight="26.0" prefWidth="277.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Supplier       : " />
                    <Label fx:id="lblDetailTanggal" prefHeight="26.0" prefWidth="293.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Tanggal       : " />
                </VBox>
            </HBox>

            <!-- Detail Table -->
            <VBox spacing="10">
                <TableView fx:id="tabelDetail" prefHeight="300" style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12; -fx-border-color: #d0d0d0;">
                    <columns>
                        <TableColumn fx:id="colDetailNamaObat" prefWidth="250.0" text="💊 Nama Obat" />
                        <TableColumn fx:id="colDetailKuantitas" prefWidth="100" text="🔢 Kuantitas" />
                        <TableColumn fx:id="colDetailHargaSatuan" prefWidth="150" text="💰 Harga Satuan" />
                        <TableColumn fx:id="colDetailSubTotal" prefWidth="150" text="💵 Subtotal" />
                    </columns>
                </TableView>
            </VBox>

            <!-- Detail Total -->
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="💰 Total Keseluruhan:" />
                <Label fx:id="lblDetailTotal" prefHeight="30.0" prefWidth="251.0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" text="Rp 0">
                    <HBox.margin>
                        <Insets right="50.0" />
                    </HBox.margin></Label>

                <!-- Close Button -->
                <Button fx:id="btnTutupDetail" onAction="#tutupDetail" prefHeight="40" prefWidth="120" style="-fx-background-color: linear-gradient(to right, #3498db, #2980b9); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 12; -fx-cursor: hand;" text="✖ Tutup" />
            </HBox>
        </VBox>
    </VBox>
</StackPane>
