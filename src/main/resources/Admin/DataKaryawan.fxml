<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Admin.Controller.DashboardDataKryController">

    <!-- Main Background -->
    <AnchorPane style="-fx-background-color: linear-gradient(to bottom, #c1e3fe, #cfeff9);">

        <!-- Main Container -->
        <VBox spacing="25" style="-fx-background-color: rgba(255,255,255,0.6); -fx-background-radius: 25; -fx-padding: 25; -fx-border-radius: 25; -fx-border-color: rgba(255,255,255,0.3);" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">

            <effect>
                <DropShadow color="#c0e0ec" offsetX="0" offsetY="10" radius="20" />
            </effect>

            <!-- Header + Search + Filter + Button -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="👥 Data Karyawan" />
                <Region HBox.hgrow="ALWAYS" />

                <!-- Filter Status -->
                <ComboBox fx:id="cbStatusFilter" prefHeight="35.0" prefWidth="140.0" promptText="Filter Status" style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-font-size: 13px; -fx-padding: 5;">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Semua Status" />
                            <String fx:value="Aktif" />
                            <String fx:value="Tidak Aktif" />
                        </FXCollections>
                    </items>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </ComboBox>

                <!-- Filter Jabatan -->
                <ComboBox fx:id="cbJabatanFilter" prefHeight="35.0" prefWidth="170.0" promptText="Filter Jabatan" style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-font-size: 13px; -fx-padding: 5;">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Semua Jabatan" />
                            <String fx:value="Admin" />
                            <String fx:value="Manajer" />
                            <String fx:value="Apoteker" />
                        </FXCollections>
                    </items>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </ComboBox>

                <!-- Search Field -->
                <TextField fx:id="searchField" prefHeight="35.0" prefWidth="200.0" promptText="🔍 Cari Data Karyawan" style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-font-size: 13px; -fx-padding: 5 10; -fx-border-color: #d0d0d0; -fx-border-width: 1; -fx-background-color: white;" />

                <!-- Tombol Tambah -->
                <Button fx:id="btnTambah" maxWidth="220" prefHeight="35.0" prefWidth="170.0" style="-fx-background-color: linear-gradient(to right, #27ae60, #2ecc71); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 12; -fx-cursor: hand;" text="➕ Tambah Karyawan">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor></Button>
            </HBox>

            <!-- TableView -->
            <TableView fx:id="tabelKaryawan" style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12; -fx-border-color: #d0d0d0;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colIDKaryawan" prefWidth="60" text="🆔 ID" />
                    <TableColumn fx:id="colNamaKaryawan" prefWidth="190.0" text="👤 Nama" />
                    <TableColumn fx:id="colJabatanKaryawan" prefWidth="140" text="💼 Jabatan" />
                    <TableColumn fx:id="colAlamatKaryawan" prefWidth="175.0" text="📍 Alamat" />
                    <TableColumn fx:id="colTeleponKaryawan" prefWidth="130" text="📞 Telepon" />
                    <TableColumn fx:id="colUsername" prefWidth="110" text="🔑 Username" />
                    <TableColumn fx:id="colPassword" prefWidth="100" text="🔒 Password" />
                    <TableColumn fx:id="colStatus" prefWidth="100" text="📌 Status" />
                    <TableColumn fx:id="colAksi" prefWidth="100" text="⚙ Aksi" />
                </columns>
                <cursor>
                    <Cursor fx:constant="HAND" />
                </cursor>
            </TableView>
        </VBox>
    </AnchorPane>

    <!-- Modal Form Overlay -->
    <VBox fx:id="formPopup" alignment="CENTER" managed="false" style="-fx-background-color: rgba(0,0,0,0.6);" visible="false" StackPane.alignment="CENTER">

        <!-- Form Container -->
        <VBox alignment="CENTER" maxWidth="800" spacing="20" style="-fx-background-color: linear-gradient(to bottom, #ffffff, #f8f9fa); -fx-padding: 35; -fx-border-radius: 25; -fx-background-radius: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 20, 0.6, 0, 8);">

            <!-- Form Header with Close Button -->
            <HBox alignment="CENTER" spacing="0" style="-fx-padding: 0 0 15 0;">
                <Region HBox.hgrow="ALWAYS" />
                <!-- Form Title -->
                <Label fx:id="formTitle" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: linear-gradient(to right, #2c3e50, #34495e);" text="📋 Form Data Karyawan" />
                <Region HBox.hgrow="ALWAYS" />
                <!-- Close Button -->
                <Button fx:id="btnCloseForm" onAction="#tutupForm" prefHeight="40.0" prefWidth="44.0"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18px; -fx-background-radius: 15; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(231,76,60,0.4), 5, 0.3, 0, 2);"
                        text="✕">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
            </HBox>

            <!-- Form Fields Container -->
            <VBox spacing="20" style="-fx-padding: 15;">

                <!-- First Row: ID and Nama -->
                <HBox alignment="CENTER" spacing="25">
                    <!-- ID Field (for edit mode) -->
                    <VBox prefWidth="350" spacing="8">
                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="🆔 ID Karyawan:" />
                        <TextField fx:id="tfID" editable="false" style="-fx-background-color: linear-gradient(to bottom, #caeaf7, #caeaf7); -fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12; -fx-font-size: 14px; -fx-text-fill: #000000; -fx-font-weight: bold;" text="Auto Generate" />
                    </VBox>

                    <!-- Nama Field -->
                    <VBox prefWidth="350" spacing="8">
                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="👤 Nama Lengkap:" />
                        <TextField fx:id="tfNama" promptText="Masukkan nama lengkap" style="-fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12; -fx-font-size: 14px; -fx-background-color: white;" />
                    </VBox>
                </HBox>

                <!-- Second Row: Jabatan and Status -->
                <HBox alignment="CENTER" spacing="25">
                    <!-- Jabatan Field -->
                    <VBox prefWidth="350" spacing="8">
                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="💼 Jabatan:" />
                        <ComboBox fx:id="tfJabatan" prefWidth="350" promptText="Pilih jabatan" style="-fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 8; -fx-font-size: 14px; -fx-background-color: white;">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Admin" />
                                    <String fx:value="Manajer" />
                                    <String fx:value="Apoteker" />
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </VBox>

                    <!-- Status Field -->
                    <VBox prefWidth="350" spacing="8">
                        <children>
                            <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="📞 Nomor Telepon:" />
                            <TextField fx:id="tfTelepon" promptText="Masukkan nomor telepon" style="-fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12; -fx-font-size: 14px; -fx-background-color: white;" />
                        </children>
                    </VBox>
                </HBox>

                <!-- Third Row: Alamat and Telepon -->
                <HBox alignment="CENTER" spacing="25">
                    <!-- Alamat Field -->
                    <VBox prefWidth="350" spacing="8">
                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="🏠 Alamat:" />
                        <TextField fx:id="tfAlamat" promptText="Masukkan alamat lengkap" style="-fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12; -fx-font-size: 14px; -fx-background-color: white;" />
                    </VBox>

                    <!-- Telepon Field -->
                    <VBox prefWidth="350" spacing="8">
                        <children>
                            <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="👤 Username:" />
                            <TextField fx:id="tfUsername" promptText="Masukkan username" style="-fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12; -fx-font-size: 14px; -fx-background-color: white;" />
                        </children>
                    </VBox>
                </HBox>

                <!-- Fourth Row: Username and Password -->
                <HBox alignment="CENTER" spacing="25">
                    <!-- Username Field -->
                    <VBox prefWidth="350" spacing="8">
                        <children>
                            <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="📊 Status:" />
                            <TextField fx:id="tfStatus" editable="false" style="-fx-background-color: linear-gradient(to bottom, #caeaf7, #caeaf7); -fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12; -fx-font-size: 14px; -fx-text-fill: #000000; -fx-font-weight: bold;" text="Aktif" />
                        </children>
                    </VBox>

                    <!-- Password Field with Show/Hide Toggle -->
                    <VBox prefWidth="350" spacing="8">
                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="🔒 Password:" />
                        <HBox alignment="CENTER_LEFT" spacing="0">
                            <TextField fx:id="tfPasswordVisible" managed="false" onKeyReleased="#syncPassword" prefWidth="290" promptText="Masukkan password" style="-fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 12 0 0 12; -fx-background-radius: 12 0 0 12; -fx-padding: 12; -fx-font-size: 14px; -fx-background-color: white;" visible="false" />
                            <PasswordField fx:id="tfPassword" managed="true" onKeyReleased="#syncPassword" prefWidth="290" promptText="Masukkan password" style="-fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 12 0 0 12; -fx-background-radius: 12 0 0 12; -fx-padding: 12; -fx-font-size: 14px; -fx-background-color: white;" visible="true" />
                            <Button fx:id="btnTogglePassword" onAction="#togglePasswordVisibility" prefHeight="46" prefWidth="60" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-border-radius: 0 12 12 0; -fx-background-radius: 0 12 12 0; -fx-cursor: hand; -fx-border-color: #3498db; -fx-border-width: 2;" text="👁" />
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Action Buttons -->
            <HBox alignment="CENTER" spacing="25" style="-fx-padding: 20 0 0 0;">
                <Button fx:id="btnSimpan" onAction="#simpanKaryawan" prefHeight="50" prefWidth="150" style="-fx-background-color: linear-gradient(to right, #27ae60, #2ecc71);                        -fx-text-fill: white;                        -fx-font-weight: bold;                        -fx-font-size: 16px;                        -fx-background-radius: 15;                        -fx-cursor: hand;                        -fx-effect: dropshadow(gaussian, rgba(39,174,96,0.4), 8, 0.3, 0, 3);" text="💾 Simpan" />
                <Button fx:id="btnBatal" onAction="#batalKaryawan" prefHeight="50" prefWidth="150" style="-fx-background-color: linear-gradient(to right, #f39c12, #e67e22);                        -fx-text-fill: white;                        -fx-font-weight: bold;                        -fx-font-size: 16px;                        -fx-background-radius: 15;                        -fx-cursor: hand;                        -fx-effect: dropshadow(gaussian, rgba(243,156,18,0.4), 8, 0.3, 0, 3);" text="🔄 Batal" />
            </HBox>
        </VBox>
    </VBox>

</StackPane>
