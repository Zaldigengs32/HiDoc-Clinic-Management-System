<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Admin.Controller.DashboardDataLayananCheckUpController">

    <!-- Main Background -->
    <AnchorPane style="-fx-background-color: linear-gradient(to bottom, #c1e3fe, #cfeff9);">

        <!-- Main Container -->
        <VBox spacing="25" style="-fx-background-color: rgba(255,255,255,0.6); -fx-background-radius: 25; -fx-padding: 25; -fx-border-radius: 25; -fx-border-color: rgba(255,255,255,0.3);" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">

            <effect>
                <DropShadow color="#c0e0ec" offsetX="0" offsetY="10" radius="20" />
            </effect>

            <!-- Header + Search + Filter + Button -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="🏥 Data Layanan Check Up" />
                <Region HBox.hgrow="ALWAYS" />

                <!-- Filter Status -->
                <ComboBox fx:id="comboFilterStatus" prefHeight="35.0" prefWidth="140.0" promptText="Filter Status" style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-font-size: 13px; -fx-padding: 5;">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Semua Status" />
                            <String fx:value="Aktif" />
                            <String fx:value="Tidak Aktif" />
                        </FXCollections>
                    </items>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </ComboBox>

                <!-- Search Field -->
                <TextField fx:id="searchField" prefHeight="35.0" prefWidth="200.0" promptText="🔍 Cari Data Layanan" style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-font-size: 13px; -fx-padding: 5 10; -fx-border-color: #d0d0d0; -fx-border-width: 1; -fx-background-color: white;" />

                <!-- Tombol Tambah -->
                <Button fx:id="btnTambahLayanan" prefHeight="35.0" prefWidth="170.0" style="-fx-background-color: linear-gradient(to right, #27ae60, #2ecc71); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 12; -fx-cursor: hand;" text="➕ Tambah Layanan">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor></Button>
            </HBox>

            <!-- Tabel Layanan -->
            <TableView fx:id="tabelLayanan" style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12; -fx-border-color: #d0d0d0;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colIDLayanan" prefWidth="90.0" text="🆔 ID" />
                    <TableColumn fx:id="colNamaLayanan" prefWidth="270.0" text="🏷 Nama Layanan" />
                    <TableColumn fx:id="colDeskripsiLayanan" prefWidth="355.0" text="📝 Deskripsi" />
                    <TableColumn fx:id="colBiayaLayanan" prefWidth="160.0" text="💰 Biaya" />
                    <TableColumn fx:id="colStatus" prefWidth="130.0" text="📌 Status" />
                    <TableColumn fx:id="colAksi" prefWidth="100.0" text="⚙ Aksi" />
                </columns>
                <cursor>
                    <Cursor fx:constant="HAND" />
                </cursor>
            </TableView>
        </VBox>
    </AnchorPane>

    <!-- Modal Form Overlay -->
    <VBox fx:id="formPopup" alignment="CENTER" managed="false" style="-fx-background-color: rgba(0,0,0,0.6);" visible="false" StackPane.alignment="CENTER">

        <!-- Form Container -->
        <VBox alignment="CENTER" maxWidth="800" spacing="20" style="-fx-background-color: linear-gradient(to bottom, #ffffff, #f8f9fa); -fx-padding: 35; -fx-border-radius: 25; -fx-background-radius: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 20, 0.6, 0, 8);">

            <!-- Form Header with Close Button -->
            <HBox alignment="CENTER" spacing="0" style="-fx-padding: 0 0 15 0;">
                <Region HBox.hgrow="ALWAYS" />
                <!-- Form Title -->
                <Label fx:id="formTitle" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: linear-gradient(to right, #2c3e50, #34495e);" text="🏥 Form Layanan Check Up" />
                <Region HBox.hgrow="ALWAYS" />
                <!-- Close Button -->
                <Button fx:id="btnCloseForm" onAction="#tutupForm" prefHeight="40.0" prefWidth="44.0"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18px; -fx-background-radius: 15; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(231,76,60,0.4), 5, 0.3, 0, 2);"
                        text="✕">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
            </HBox>

            <!-- Form Fields Container -->
            <VBox spacing="20" style="-fx-padding: 15;">

                <!-- First Row: ID and Nama Layanan -->
                <HBox alignment="CENTER" spacing="25">
                    <!-- ID Field (Auto Generate) -->
                    <VBox prefWidth="350" spacing="8">
                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="🆔 ID Layanan:" />
                        <TextField fx:id="tfIDLayanan" editable="false" style="-fx-background-color: linear-gradient(to bottom, #caeaf7, #caeaf7); -fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12; -fx-font-size: 14px; -fx-text-fill: #000000; -fx-font-weight: bold;" />
                    </VBox>

                    <!-- Nama Layanan Field -->
                    <VBox prefWidth="350" spacing="8">
                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="🏷 Nama Layanan:" />
                        <TextField fx:id="tfNamaLayanan" promptText="Masukkan nama layanan" style="-fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12; -fx-font-size: 14px; -fx-background-color: white;" />
                    </VBox>
                </HBox>

                <!-- Second Row: Deskripsi and Biaya -->
                <HBox alignment="CENTER" spacing="25">
                    <!-- Deskripsi Field -->
                    <VBox prefHeight="79.0" prefWidth="833.0" spacing="8">
                        <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="📝 Deskripsi:" />
                        <TextField fx:id="tfDeskripsiLayanan" prefHeight="49.0" prefWidth="667.0" promptText="Masukkan deskripsi layanan" style="-fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12; -fx-font-size: 14px; -fx-background-color: white;" />
                    </VBox>
                </HBox>

                <!-- Third Row: Status Display (Read-only) -->
                <HBox alignment="CENTER" spacing="25">
                    <!-- Status Field (Display only) -->
                    <VBox prefWidth="350" spacing="8">
                        <children>
                            <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="💰 Biaya Layanan:" />
                            <TextField fx:id="tfBiayaLayanan" promptText="Masukkan biaya layanan" style="-fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12; -fx-font-size: 14px; -fx-background-color: white;" />
                        </children>
                    </VBox>

                    <!-- Empty space to maintain alignment -->
                    <VBox prefWidth="350" spacing="8">
                        <children>
                            <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="📊 Status Layanan:" />
                            <TextField fx:id="tfStatusLayanan" editable="false" style="-fx-background-color: linear-gradient(to bottom, #caeaf7, #caeaf7); -fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12; -fx-font-size: 14px; -fx-text-fill: #000000; -fx-font-weight: bold;" text="Aktif" />
                        </children></VBox>
                </HBox>
            </VBox>

            <!-- Action Buttons -->
            <HBox alignment="CENTER" spacing="25" style="-fx-padding: 20 0 0 0;">
                <Button fx:id="btnSimpanLayanan" prefHeight="50" prefWidth="150" style="-fx-background-color: linear-gradient(to right, #27ae60, #2ecc71); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 15; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(39,174,96,0.4), 8, 0.3, 0, 3);" text="💾 Simpan" />
                <Button fx:id="btnBatalLayanan" prefHeight="50" prefWidth="150" style="-fx-background-color: linear-gradient(to right, #f39c12, #e67e22); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 15; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(243,156,18,0.4), 8, 0.3, 0, 3);" text="🔄 Batal" />
            </HBox>
        </VBox>
    </VBox>

    <!-- Popup Konfirmasi Hapus - Complete Design -->
    <VBox fx:id="confirmHapusPopup" alignment="CENTER" managed="false" style="-fx-background-color: rgba(0,0,0,0.6);" visible="false" StackPane.alignment="CENTER">
        <VBox alignment="CENTER" maxWidth="450" spacing="25" style="-fx-background-color: linear-gradient(to bottom, #ffffff, #f8f9fa); -fx-padding: 35; -fx-border-radius: 20; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 15, 0.6, 0, 5);">

            <!-- Warning Icon and Title -->
            <Label style="-fx-text-fill: #e74c3c; -fx-font-size: 22px; -fx-font-weight: bold; -fx-text-alignment: center;" text="⚠ Konfirmasi Hapus" />

            <!-- Confirmation Message -->
            <Label fx:id="confirmMessage" style="-fx-text-fill: #2c3e50; -fx-font-size: 15px; -fx-text-alignment: center; -fx-wrap-text: true; -fx-line-spacing: 3px;" text="Apakah Anda yakin ingin menghapus layanan ini?" wrapText="true" />

            <!-- Action Buttons -->
            <HBox alignment="CENTER" spacing="20" style="-fx-padding: 15 0 0 0;">
                <Button fx:id="btnYaHapusLayanan" prefHeight="45" prefWidth="120" style="-fx-background-color: linear-gradient(to right, #e74c3c, #c0392b); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(231,76,60,0.4), 8, 0.3, 0, 3);" text="✓ Ya, Hapus" />
                <Button fx:id="btnTidakHapusLayanan" prefHeight="45" prefWidth="120" style="-fx-background-color: linear-gradient(to right, #95a5a6, #7f8c8d); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(149,165,166,0.4), 8, 0.3, 0, 3);" text="✗ Batal" />
            </HBox>
        </VBox>
    </VBox>

</StackPane>